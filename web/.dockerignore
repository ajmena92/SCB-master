# Secrets and local configuration must never be sent as Docker build context.
.env
**/.env
*.pem
*.key

# Local dependencies, build output, tests and generated artifacts.
frontend/node_modules
frontend/build
backend/__pycache__
backend/**/__pycache__
backend/.pytest_cache
backend/.mypy_cache
backend/tests
backend/**/pruebas
**/*.pyc
**/*.pyc.*
test_reports
coverage

# Repository/editor metadata and non-production source material.
.git
.gitignore
.DS_Store
memory
test_result.md
