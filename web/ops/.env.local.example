# SCB Portal Web - Environment Variables (LOCAL DEVELOPMENT)
# Copiar a .env y llenar con valores de desarrollo local
# Este archivo contiene solo valores de DESARROLLO - NUNCA usar en producción

# ============================================================
# POSTGRESQL - Valores de desarrollo local
# ============================================================
POSTGRES_DB=scb_dev
POSTGRES_ADMIN_USER=scb_admin
POSTGRES_APP_USER=scb_api
POSTGRES_MIGRATOR_USER=scb_migrador

# En desarrollo local: archivos con secretos débiles para testing
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres_admin_password
POSTGRES_APP_PASSWORD_FILE=./secrets/postgres_app_password
POSTGRES_MIGRATOR_PASSWORD_FILE=./secrets/postgres_migrator_password

# Rutas locales para datos y backups
POSTGRES_WAL_ARCHIVE_PATH=./postgres_wal_archive
POSTGRES_BACKUP_PATH=./postgres_backups
POSTGRES_SHM_SIZE=128m

# ============================================================
# APLICACIÓN - Desarrollo local (HTTP, cookies no seguras)
# ============================================================
APP_ENV=development
APP_TZ=America/Costa_Rica
CORS_ORIGIN=http://localhost:8081
COOKIE_SECURE=false

# ============================================================
# SECRETOS - Rutas a archivos locales (NO valores reales)
# ============================================================
CSRF_SECRET_FILE=./secrets/csrf_secret
CARNET_QR_CLAVE_FILE=./secrets/carnet_qr_clave
IMPORTACION_RESULTADOS_KEY_FILE=./secrets/importacion_resultados_key

# ============================================================
# SEGURIDAD - Desarrollo (valores permisivos)
# ============================================================
CSRF_ANONYMOUS_TTL_SECONDS=600
TRUSTED_PROXY_CIDRS=172.16.0.0/12
FORWARDED_ALLOW_IPS=*

# ============================================================
# SESIONES - Desarrollo (tiempos normales)
# ============================================================
STUDENT_SESSION_DAYS=365
ADMIN_SESSION_MINUTES=60
STUDENT_MAX_LOGIN_ATTEMPTS=8
STUDENT_LOCK_MINUTES=5
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# ============================================================
# UVICORN (API) - Desarrollo (1 worker)
# ============================================================
UVICORN_WORKERS=1

# ============================================================
# RECURSOS (Docker Compose) - Desarrollo (limitaciones mínimas)
# ============================================================
API_MEMORIA_LIMITE=512m
API_MEMORIA_RESERVA=256m
API_CPUS=2.0

WEB_MEMORIA_LIMITE=128m
WEB_MEMORIA_RESERVA=64m
WEB_HOST=127.0.0.1
WEB_PUERTO=8081

# ============================================================
# BASE DE DATOS (Alembic Migrations)
# ============================================================
MIGRACION_MANUAL_DBA=no_confirmada

# Secretos opcionales de las tareas manuales de importación.
SQL_SERVER_ORIGEN_FILE=./secrets/sql_server_origen
CODIGO_MIGRACION_SEMILLA_FILE=./secrets/codigo_migracion_semilla

# ============================================================
# SETUP LOCAL
# ============================================================
# Para usar este archivo:
# 1. cp .env.local.example .env
# 2. Generar secretos: ./scripts/gen_secrets_dev.sh
# 3. docker compose up
