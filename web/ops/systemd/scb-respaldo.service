[Unit]
Description=Respaldo diario verificable de PostgreSQL SCB
After=docker.service srv-scb-postgresql-v2.mount
Requires=docker.service
OnFailure=scb-alerta@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/plat/scsc-comedor/ops
ExecStart=/usr/bin/docker compose --env-file .env -f compose.production.yml -f compose.production.hardening.yml --profile respaldo run --rm --no-deps respaldo
ExecStartPost=/usr/local/sbin/scb-respaldo-google
