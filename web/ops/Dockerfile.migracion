# Imagen aislada para comprobar y ejecutar migraciones Alembic.
# Nunca se usa como contenedor de la API ni contiene pruebas de desarrollo.
FROM python:3.12.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg unixodbc-dev \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -o /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements-produccion.txt backend/requirements-migracion.txt ./
RUN pip install --no-compile --requirement requirements-migracion.txt \
    && rm requirements-produccion.txt requirements-migracion.txt

COPY backend/aplicacion ./aplicacion
COPY backend/config.py ./config.py
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
COPY ops/entrada_migracion.sh /usr/local/bin/entrada_migracion.sh
RUN useradd --create-home --uid 10001 appuser \
    && chmod 0550 /usr/local/bin/entrada_migracion.sh \
    && chown -R appuser:appuser /app /usr/local/bin/entrada_migracion.sh
USER appuser

ENTRYPOINT ["/usr/local/bin/entrada_migracion.sh"]
CMD ["current"]
