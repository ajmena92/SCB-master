FROM python:3.12.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/requirements-analitica.txt backend/requirements-produccion.txt ./
RUN pip install --no-compile --requirement requirements-analitica.txt \
    && rm requirements-analitica.txt requirements-produccion.txt
COPY backend/analitica ./analitica
COPY ops/entrada_analitica.sh /usr/local/bin/entrada_analitica.sh
RUN useradd --create-home --uid 10001 analitica \
    && chmod 0550 /usr/local/bin/entrada_analitica.sh \
    && chown -R analitica:analitica /app /usr/local/bin/entrada_analitica.sh
USER analitica
ENTRYPOINT ["/usr/local/bin/entrada_analitica.sh"]
