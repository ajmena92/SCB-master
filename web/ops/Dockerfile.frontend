# Stage 1: Build React application
FROM node:24.19-bookworm-slim AS build

WORKDIR /app

# Enable Corepack to use npm version from packageManager in package.json
RUN corepack enable npm

# Copy dependency files first (layer caching)
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies (npm ci = clean install from lockfile)
RUN npm ci --no-audit --no-fund

# Copy application source
COPY frontend/ ./

# Build the application
RUN npm run build

# Stage 2: Runtime with Nginx
FROM nginx:1.30.4-alpine

# Copy Nginx configuration
COPY ops/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy compiled frontend artifacts from build stage
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
