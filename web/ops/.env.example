# Copy this file to .env on the deployment host. Do not commit .env.
# Values below are examples only; obtain secrets through the institutional secret store.
# Backend settings. This file is consumed by compose; values must match
# web/backend/config.py exactly. Obtain the real connection string from the
# institutional secret store and never commit it.
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:sqlserver.institucion.local,1433;Database=SCSC;Uid=portal_comedor;Pwd=REPLACE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=15
CORS_ORIGIN=https://comedor.institucion.ac.cr
COOKIE_SECURE=true
APP_TZ=America/Costa_Rica
STUDENT_SESSION_DAYS=365
ADMIN_SESSION_MINUTES=60
STUDENT_MAX_LOGIN_ATTEMPTS=5
STUDENT_LOCK_MINUTES=15
ENVIRONMENT=production
UVICORN_WORKERS=2
# Límites iniciales derivados de una medición local controlada: API 133.10 MiB
# en carga de subida y web 11.13 MiB estáticos. Revalide ambos en staging con
# la puerta operativa antes de promover cambios de carga o dependencias.
API_MEMORIA_LIMITE=256m
API_MEMORIA_RESERVA=128m
WEB_MEMORIA_LIMITE=64m
WEB_MEMORIA_RESERVA=32m
# The subnet is allocated to this Compose network. Infrastructure must choose a
# non-overlapping private range and keep the two trust settings identical.
COMPOSE_PRIVATE_SUBNET=172.30.83.0/24
# Limit both settings to the internal reverse-proxy network. Do not use '*'.
FORWARDED_ALLOW_IPS=172.30.83.0/24
TRUSTED_PROXY_CIDRS=172.30.83.0/24
