# Copiar como .env con permiso 0600. No escribir contraseñas aquí.
COMPOSE_ENV_FILE=.env
POSTGRES_DB=scb
POSTGRES_ADMIN_USER=scb_admin
POSTGRES_APP_USER=scb_api
POSTGRES_MIGRATOR_USER=scb_migrador
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres_admin_password
POSTGRES_APP_PASSWORD_FILE=./secrets/postgres_app_password
POSTGRES_MIGRATOR_PASSWORD_FILE=./secrets/postgres_migrator_password
SQL_SERVER_ORIGEN_FILE=./secrets/sql_server_origen
CODIGO_MIGRACION_SEMILLA_FILE=./secrets/codigo_migracion_semilla
IMPORTACION_TRABAJO_PATH=./importaciones
POSTGRES_BACKUP_PATH=/mnt/scb-backups-postgresql
POSTGRES_WAL_ARCHIVE_PATH=/mnt/scb-wal-postgresql
RETENCION_RESPALDOS_DIAS=30
POSTGRES_SHM_SIZE=128m
CORS_ORIGIN=https://comedor.institucion.ac.cr
COOKIE_SECURE=true
ENVIRONMENT=production
APP_TZ=America/Costa_Rica
TRUSTED_PROXY_CIDRS=172.20.0.0/16
FORWARDED_ALLOW_IPS=172.20.0.0/16
API_MEMORIA_LIMITE=256m
API_MEMORIA_RESERVA=128m
WEB_MEMORIA_LIMITE=64m
WEB_MEMORIA_RESERVA=32m
WEB_PUERTO=8081
STUDENT_SESSION_DAYS=365
ADMIN_SESSION_MINUTES=60
STUDENT_MAX_LOGIN_ATTEMPTS=8
STUDENT_LOCK_MINUTES=5
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
UVICORN_WORKERS=2
