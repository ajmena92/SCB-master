# Copy outside source control. Never put production values in this repository.
# Driver 18 requires encryption; TrustServerCertificate=no is required in production.
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:sqlserver.institucion.local,1433;Database=SCSC;Uid=portal_comedor;Pwd=REPLACE_ME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=15
CORS_ORIGIN=https://comedor.institucion.ac.cr
COOKIE_SECURE=true
APP_TZ=America/Costa_Rica
STUDENT_SESSION_DAYS=365
ADMIN_SESSION_MINUTES=60
STUDENT_MAX_LOGIN_ATTEMPTS=8
STUDENT_LOCK_MINUTES=5
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
ENVIRONMENT=production
FORWARDED_ALLOW_IPS=127.0.0.1/32
TRUSTED_PROXY_CIDRS=127.0.0.1/32
