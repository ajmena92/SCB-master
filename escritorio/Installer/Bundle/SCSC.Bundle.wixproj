<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\..\build\version.props" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion>$(SCSCInstallerVersion)</ProductVersion>
    <MsiSource Condition=" '$(MsiSource)' == '' ">$(MSBuildProjectDirectory)\..\Msi\bin\$(Configuration)\SCSC-App.msi</MsiSource>
    <AppExePath Condition=" '$(AppExePath)' == '' ">$(MSBuildProjectDirectory)\..\..\SCSC\bin\Release\SCSC_Marcas.exe</AppExePath>
    <OutputName>SCSC-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' ">$(MSBuildExtensionsPath32)\Microsoft\WiX\v3.x\Wix.targets</WixTargetsPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DefineSolutionProperties>false</DefineSolutionProperties>
    <SuppressSpecificWarnings>1133</SuppressSpecificWarnings>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiSource=$(MsiSource);AppExePath=$(AppExePath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixBalExtension" />
  </ItemGroup>
  <Import Project="$(WixTargetsPath)" />
</Project>
